# Copie este arquivo para .env e cole a chave. O .env esta no .gitignore.
# Gere em: https://aistudio.google.com/apikey
#
# ATENCAO — a cota gratuita do Gemini e contada POR PROJETO, nao por chave.
# Hoje esta chave vive no mesmo projeto do outro app (o mesmo do outro app),
# entao processar um PDF grande consome cota do app de caixa em producao.
# Chave separada isola a revogacao, nao o limite de requisicoes.
# Quando der para criar um projeto novo, gere a chave la e troque aqui.
GEMINI_API_KEY=

# Modelo usado nas duas passadas. Conferir no AI Studio quais estao
# disponiveis na camada gratuita antes de trocar.
GEMINI_MODEL=gemini-2.5-flash

# --- CONTAS E LOG DE ACESSO ---

# Codigo exigido no cadastro. SEM ELE O SERVIDOR NAO SOBE.
# Faz o papel que a senha unica fazia: separar conhecidos de desconhecidos.
# Sem isso, qualquer um que ache a URL cria conta e gasta o seu saldo.
CODIGO_CONVITE=

# Quem enxerga o log de acesso completo (quem entrou, o que mandou, quanto
# gastou). Os demais veem so o proprio historico.
ADMIN_EMAIL=

# Banco. Sem os dois, os dados vao para um arquivo em trabalho/ — serve para
# rodar na sua maquina, NAO no Render, onde o disco e apagado a cada deploy.
# A service key ignora RLS: use so no servidor, nunca no navegador.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
